# ------------------------------------------------------------------
# Better Auth
# ------------------------------------------------------------------
# openssl rand -base64 32  ile üret
BETTER_AUTH_SECRET="degistir-bunu-32-karakterlik-rastgele-deger"
BETTER_AUTH_URL="https://spor.tavukciftligi.lol"
NEXT_PUBLIC_APP_URL="https://spor.tavukciftligi.lol"

# Discord ile giriş (opsiyonel — boş bırakılırsa buton gizlenir)
# Discord Developer Portal → OAuth2 → Redirects:
#   https://spor.tavukciftligi.lol/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Google ile giriş (opsiyonel)
# Yetkili yönlendirme URI'si: https://spor.tavukciftligi.lol/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------
# Maç verisi — football-data.org (ücretsiz hesap)
# ------------------------------------------------------------------
FOOTBALL_DATA_TOKEN="football-data-api-anahtarin"
# BOŞ BIRAK. Ücretsiz katman yalnızca güncel sezonu verir; season filtresi
# 403 döndürebilir. Sadece geçmiş bir sezonu zorlamak istersen doldur.
FD_SEASON=""

# ------------------------------------------------------------------
# Marka (opsiyonel)
# ------------------------------------------------------------------
# Kendi logonu koymak için: dosyayı public/ altına at, yolunu buraya yaz.
# Boş bırakılırsa varsayılan yıldız-top işareti kullanılır.
# Favicon ayrı: src/app/icon.svg ve src/app/favicon.ico dosyalarını değiştir.
NEXT_PUBLIC_BRAND_LOGO=""

# ------------------------------------------------------------------
# Cron güvenliği — /api/cron/sync bu anahtarı ister
